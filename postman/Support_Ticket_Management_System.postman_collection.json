            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"URGENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/tickets/{{ticketId}}/priority",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tickets", "{{ticketId}}", "priority"]
            }
          }
        },
        {
          "name": "Get Ticket Activity Audit Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/tickets/{{ticketId}}/activity-logs",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tickets", "{{ticketId}}", "activity-logs"]
            }
          }
        },
        {
          "name": "Get All System Activity Logs (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/activity-logs?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "activity-logs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    }
  ]
}
