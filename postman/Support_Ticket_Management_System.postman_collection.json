              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/tickets/{{ticketId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "tickets", "{{ticketId}}", "status"]
